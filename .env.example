# 服务端数据库和证书配置；请填写实际密码，不要分享此文件。
app.database.url=jdbc:postgresql://localhost:5432/terminal_agent
app.database.user=agent
app.database.password=请填写数据库密码
app.tls.keystore=C:/Users/yang/terminal-agent-dev.p12
app.tls.password=请填写证书密码

# DeepSeek API 密钥仅写在服务器配置中，勿提交或分享。
DEEPSEEK_API_KEY=请填写DeepSeek_API密钥
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_OUTPUT=1024
