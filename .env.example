# 服务端数据库和证书配置；请填写实际密码，不要分享此文件。
app.database.url=jdbc:postgresql://localhost:5432/terminal_agent
app.database.user=agent
app.database.password=请填写数据库密码
app.tls.keystore=C:/Users/yang/terminal-agent-dev.p12
app.tls.password=请填写证书密码

# OpenAI 兼容 Chat Completions 接口；密钥只保存在服务端。
MODEL_API_URL=https://api.deepseek.com/chat/completions
MODEL_API_KEY=请填写模型服务API密钥
MODEL_NAME=deepseek-flash

# 可选：外部 UTF-8 系统提示词文件；留空使用 JAR 内置版本。
# SYSTEM_PROMPT_PATH=/opt/terminal-agent/system.md

# 可选：仅当服务商支持该参数时使用 enabled 或 disabled。
# MODEL_THINKING=disabled
